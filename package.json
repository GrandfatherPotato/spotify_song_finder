{
  "name": "backtrack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "26.13.1",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "spec:update": "node scripts/update-spec.ts",
    "spec:check": "node scripts/update-spec.ts --check",
    "spec:types": "node scripts/generate-types.ts",
    "type-check": "vue-tsc -b",
    "eslint": "eslint .",
    "eslint:fix": "eslint . --fix",
    "prettier": "prettier --check .",
    "format": "prettier --write .",
    "lint": "pnpm type-check && pnpm prettier && pnpm eslint",
    "lint:fix": "pnpm type-check && pnpm format && pnpm eslint:fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "bash -c 'pnpm type-check'",
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,css,md,yml,yaml,html}": "prettier --write"
  },
  "dependencies": {
    "echarts": "6.1.0",
    "fflate": "0.8.3",
    "pinia": "4.1.0",
    "vue": "3.5.45",
    "vue-echarts": "8.3.2",
    "vue-router": "5.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/user-event": "14.6.10",
    "@testing-library/vue": "8.1.0",
    "@types/node": "26.6.6",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/coverage-v8": "5.1.0",
    "@vue/tsconfig": "0.9.1",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-vue": "10.12.1",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "lint-staged": "17.6.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14",
    "yaml": "2.9.1"
  }
}
