# Copy to `.env.local` and fill in your own values. Never commit a filled-in copy.
#
# The client ID is public and safe to inline into the bundle. A client SECRET is
# not — the PKCE flow this app uses does not need one, so there is no secret here.

# `local` or `hosted`, defaulting to `hosted` when unset. Only `local` offers to
# import the gitignored `data/` export, which the dev server alone can serve.
# Set this to `local` in `.env.local`; never in a build you deploy.
VITE_APP_ENV=local

# Spotify Developer Dashboard -> your app -> Settings -> Client ID
VITE_SPOTIFY_CLIENT_ID=

# Must match a redirect URI registered in the Dashboard exactly (scheme, host,
# port, path). Spotify rejects `localhost`; use the loopback literal instead.
# Defaults to `<current origin>/callback` when left blank.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback

# https://www.last.fm/api/account/create — supplies the genre labels Spotify no
# longer returns. The API key is public and travels in every query string, so
# inlining it is fine. The shared secret issued alongside it is NOT: this app
# only calls read methods, which never need it. Never put that secret here.
VITE_LAST_FM_API_KEY=